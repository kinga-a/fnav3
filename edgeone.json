{
  "routes": [
    {
      "src": "/api/(.*)",
      "function": "api/[[default]]"
    },
    {
      "src": "/s/(.*)",
      "function": "s/[[default]]"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    }
  ]
}
