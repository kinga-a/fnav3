{
  "routes": [
    {
      "src": "/api/(.*)",
      "function": "[[default]]"
    },
    {
      "src": "/([a-zA-Z0-9_-]{3,32})",
      "function": "[[default]]"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    }
  ]
}
